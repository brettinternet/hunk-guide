      "explanation": "Two trains give the board an on-time row and a delayed row.",
      "targets": [
        {
          "id": "departure-type",
          "path": "src/departures.ts",
          "side": "new",
          "startLine": 1,
          "endLine": 6
        },
        {
          "id": "departure-data",
          "path": "src/departures.ts",
          "side": "new",
          "startLine": 8,
          "endLine": 11
        }
      ]
    },
    {
      "id": "display",
      "kind": "change",
      "title": "Build one readable row",
      "explanation": "The status helper supplies the badge. The board lines up times, destinations, and platforms.",
