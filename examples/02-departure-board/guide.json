{
  "$schema": "../../hunk-guide.schema.json",
  "version": 1,
  "id": "02-departure-board",
  "title": "Build the departure board",
  "summary": "Follow the data into a compact station display, then check the output.",
  "sections": [
    {
      "id": "departures",
