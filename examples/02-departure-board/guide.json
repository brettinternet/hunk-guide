        {
          "id": "status-helper",
          "path": "src/status.ts",
          "side": "new",
          "startLine": 1,
          "endLine": 5
        },
        {
          "id": "board-renderer",
          "path": "src/board.ts",
          "side": "new",
          "startLine": 4,
          "endLine": 11
        }
      ]
    },
    {
      "id": "verification",
      "kind": "verification",
      "title": "Check both rows",
      "explanation": "The output test keeps the two statuses and column spacing visible together.",
      "targets": [
        {
          "id": "board-test",
          "path": "tests/board.test.ts",
          "side": "new",
          "startLine": 4,
          "endLine": 9
