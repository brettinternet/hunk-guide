diff --git a/src/resolver.ts b/src/resolver.ts
new file mode 100644
index 0000000..3333333
--- /dev/null
+++ b/src/resolver.ts
@@ -0,0 +1,10 @@
+import { hasExplicitValue, type Policy } from './policy'
+
+export function resolveEffectivePolicy(policies: Map<string, Policy>, id: string) {
+  let policy = policies.get(id)
+  while (policy && !hasExplicitValue(policy)) {
+    policy = policy.parentId ? policies.get(policy.parentId) : undefined
+  }
+
+  return policy?.value ?? 'default'
+}

