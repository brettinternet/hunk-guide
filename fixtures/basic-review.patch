@@ -0,0 +1,9 @@
+import type { PolicySource } from '../policy-types'
+
+export function policyResponse(value: string, source: PolicySource) {
+  return {
+    value,
+    source: source.kind,
+    inheritedFrom: source.kind === 'inherited' ? source.parentId : null,
+  }
+}

