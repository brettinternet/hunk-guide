--- /dev/null
+++ b/src/enrollment.ts
@@ -0,0 +1,9 @@
+import type { Policy } from './policy'
+import { resolveEffectivePolicy } from './resolver'
+
+export function enrollDevice(policies: Map<string, Policy>, policyId: string) {
+  return {
+    policyId,
+    effectivePolicy: resolveEffectivePolicy(policies, policyId),
+  }
+}

