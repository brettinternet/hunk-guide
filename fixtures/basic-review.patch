@@ -0,0 +1,8 @@
+import { expect, test } from 'bun:test'
+import { resolveEffectivePolicy } from '../src/resolver'
+
+test('inherits the first explicit policy value', () => {
+  const policies = new Map([['child', { id: 'child', parentId: 'parent' }], ['parent', { id: 'parent', value: 'strict' }]])
+  expect(resolveEffectivePolicy(policies, 'child')).toBe('strict')
+})
+

